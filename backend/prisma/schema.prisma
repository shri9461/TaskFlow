// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  password  String
  status    String?  @default("Available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String?
  completed      Boolean   @default(false)

  // Corporate & Office Productivity fields
  department     String?   // "Engineering" | "Marketing" | "Product" | "Finance" | "HR" | "Sales" | "Operations" | "Executive" | "General"
  category       String?   // "Sprint Task" | "Meeting Action" | "Client Deliverable" | "1-on-1 Prep" | "Quarterly OKR"
  estimatedHours Float?    // Sprint & timesheet estimate (e.g. 2.5)
  actualHours    Float?    // Hours spent (e.g. 1.5)
  assignee       String?   // Colleague or delegate name / email
  subtasks       String?   // JSON string of checklist items: [{"id":"1","title":"Subtask","completed":false}]
  notes          String?   // Rich meeting notes / corporate context
  impact         String?   // "critical" | "moderate" | "routine"

  // Timing fields
  timingType     String?   // "specific" | "deadline" | "duration"
  timingValue    String?   // ISO date string or duration like "4h" / "2d"
  dueDate        DateTime?

  // Priority
  importance     String?   // "urgent" | "high" | "medium" | "low"

  // Reminder tracking
  reminderSent   Boolean   @default(false)
  reminderAt     DateTime?

  // Focus Mode
  focusMode      Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}